{
  "name": "rally-point-app",
  "version": "1.0.0",
  "description": "A comprehensive field operations management platform for Bible workers and literature evangelists",
  "main": "index.ts",
  "author": "Rally Point Development Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/rally-point-app.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/rally-point-app/issues"
  },
  "homepage": "https://github.com/yourusername/rally-point-app#readme",
  "keywords": [
    "react-native",
    "expo",
    "ministry",
    "field-operations",
    "gps-tracking",
    "survey-management",
    "team-collaboration"
  ],
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build": "expo export --platform web",
    "build:web": "expo export --platform web",
    "build:android": "npx expo prebuild --platform android && cd android && ./gradlew assembleRelease",
    "build:ios": "npx expo prebuild --platform ios",
    "preview": "npx serve dist",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@expo/metro-runtime": "~5.0.4",
    "@expo/vector-icons": "^14.1.0",
    "@hookform/resolvers": "^5.2.1",
    "@maplibre/maplibre-react-native": "^10.4.1",
    "@react-native-async-storage/async-storage": "^2.1.2",
    "@react-native-community/datetimepicker": "^8.4.4",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-native-google-signin/google-signin": "^16.0.0",
    "@react-native-picker/picker": "^2.11.1",
    "@react-navigation/bottom-tabs": "^7.4.6",
    "@react-navigation/native": "^7.1.17",
    "@react-navigation/stack": "^7.4.7",
    "@reduxjs/toolkit": "^2.9.2",
    "@supabase/supabase-js": "^2.76.1",
    "@types/leaflet": "^1.9.21",
    "@types/react-native-vector-icons": "^6.4.18",
    "axios": "^1.13.0",
    "buffer": "^6.0.3",
    "expo": "~53.0.23",
    "expo-auth-session": "^7.0.8",
    "expo-av": "~15.1.7",
    "expo-blur": "^15.0.7",
    "expo-crypto": "^15.0.7",
    "expo-dev-client": "~5.2.4",
    "expo-device": "^7.1.4",
    "expo-document-picker": "^13.1.6",
    "expo-file-system": "^18.1.11",
    "expo-image-picker": "^17.0.8",
    "expo-linear-gradient": "^14.1.5",
    "expo-location": "~18.1.6",
    "expo-notifications": "^0.31.4",
    "expo-status-bar": "~2.2.3",
    "expo-updates": "~0.28.17",
    "leaflet": "^1.9.4",
    "mapbox-gl": "^3.16.0",
    "maplibre-gl": "^5.13.0",
    "nativewind": "^4.1.23",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "^7.62.0",
    "react-leaflet": "^5.0.0",
    "react-native": "0.79.5",
    "react-native-country-picker-modal": "^2.0.0",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-maps": "1.20.1",
    "react-native-reanimated": "^4.1.3",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "^15.13.0",
    "react-native-vector-icons": "^10.3.0",
    "react-native-web": "^0.20.0",
    "react-native-webview": "13.13.5",
    "react-native-worklets": "^0.6.1",
    "react-redux": "^9.2.0",
    "redux-persist": "^6.0.0",
    "yup": "^1.7.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.3.0",
    "@types/jest": "^29.5.5",
    "@types/react": "~19.0.10",
    "jest": "^29.7.0",
    "jest-expo": "^51.0.3",
    "react-native-svg-transformer": "^1.5.0",
    "react-test-renderer": "^18.2.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "@react-native-community/cli": "latest"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "@testing-library/jest-native/extend-expect"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg)"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts",
      "!src/**/__tests__/**",
      "!src/**/node_modules/**"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "testMatch": [
      "**/__tests__/**/*.(ts|tsx|js)",
      "**/*.(test|spec).(ts|tsx|js)"
    ]
  },
  "private": true
}
