  // Get territories assigned to a specific worker
  async getWorkerTerritories(workerId: string): Promise<{ territories: Territory[]; count: number }> {
    const id = workerId || (await this.getCurrentUserId());
    if (!id) {
      return { territories: [], count: 0 };
    }
    try {
      const response = await this.makeRequest<{ territories: Territory[]; count: number }>(
        `/api/workers/${id}/territories`
      );
      return response;
    } catch (error) {
      // If backend returns 404 (e.g., route missing or no territories endpoint), return empty result
      const message = String((error as any)?.message || '').toLowerCase();
      if (message.includes('404')) {
        console.warn('⚠️ Worker territories endpoint returned 404; returning empty list.');
        return { territories: [], count: 0 };
      }
      console.error('❌ Error loading worker territories:', error);
      throw error;
    }
  }

  async getCurrentUserId(): Promise<string | null> {
    try {
      const me = await this.makeRequest<any>('/api/users/me');
      return me?.id || null;
    } catch (e) {
      return null;
    }
  }

  // Get territory statistics for the team
  async getTeamStats(): Promise<TerritoryStats> {
    try {
      // Get territories and calculate stats from them
      const territoriesResponse = await this.getTeamTerritories();
      
      const stats: TerritoryStats = {
        total_territories: territoriesResponse.count,
        assigned_territories: territoriesResponse.territories?.filter(t => t.assigned_worker_id).length || 0,
        covered_today: 0, // TODO: Implement coverage tracking
        total_coverage: 0, // TODO: Calculate from territory data
        active_workers: 0, // TODO: Get from user service
      };

      console.log('📊 Team territory stats (calculated):', stats);
      return stats;
    } catch (error) {
      console.error('❌ Error loading team stats:', error);
      return {
        total_territories: 0,
        assigned_territories: 0,
        covered_today: 0,
        total_coverage: 0,
        active_workers: 0,
      };
    }
  }

  // Update an existing territory
  async updateTerritory(territoryId: string, updates: Partial<Territory>): Promise<Territory> {
    try {
      const response = await this.makeRequest<Territory>(`/api/territories/${territoryId}`, {
        method: 'PUT',
        body: JSON.stringify(updates),
      });

      console.log('✅ Updated territory:', response.name);
      return response;
    } catch (error) {
      console.error('❌ Error updating territory:', error);
      throw error;
    }
  }

  // Create a new territory
  async createTerritory(territoryData: {
    name: string;
    description?: string;
    team_id: string;
    boundary: string; // GeoJSON polygon
    color?: string;
  }): Promise<Territory> {
    try {
      const response = await this.makeRequest<Territory>('/api/territories/', {
        method: 'POST',
        body: JSON.stringify(territoryData),
      });

      console.log('✅ Created territory:', response.name);
      return response;
    } catch (error) {
      console.error('❌ Error creating territory:', error);
      throw error;
    }
  }

  // Delete a territory
  async deleteTerritory(territoryId: string): Promise<void> {
    try {
      await this.makeRequest(`/api/territories/${territoryId}`, {
        method: 'DELETE',
      });

      console.log('✅ Deleted territory:', territoryId);
    } catch (error) {
      console.error('❌ Error deleting territory:', error);
      throw error;
    }
  }

  // Get territory by ID
  async getTerritory(territoryId: string): Promise<Territory> {
    try {
      const response = await this.makeRequest<Territory>(`/api/territories/${territoryId}`);
      return response;
    } catch (error) {
      console.error('❌ Error loading territory:', error);
      throw error;
    }
  }

  // Assign a territory to a worker
  async assignTerritory(territoryId: string, workerId: string): Promise<void> {
    try {
      await this.makeRequest(`/api/territories/${territoryId}/assign`, {
        method: 'PUT',
        body: JSON.stringify({ assigned_worker_id: workerId })
      });
      console.log(`✅ Assigned territory ${territoryId} to worker ${workerId}`);
    } catch (error) {
      console.error('❌ Error assigning territory:', error);
      throw error;
    }
  }

  // Unassign a territory
  async unassignTerritory(territoryId: string): Promise<void> {
    try {
      await this.makeRequest(`/api/territories/${territoryId}/assign`, {
        method: 'PUT',
        body: JSON.stringify({ assigned_worker_id: null })
      });
      console.log(`✅ Unassigned territory ${territoryId}`);
    } catch (error) {
      console.error('❌ Error unassigning territory:', error);
      throw error;
    }
  }

  // Get current user's team_id from backend profile
  async getCurrentTeamId(): Promise<string | null> {
    try {
      const user = await this.makeRequest<any>('/api/users/profile');
      const teamId = user?.team_id || null;
      if (!teamId) {
        console.warn('⚠️ No team_id on current user profile');
      }
      return teamId;
    } catch (error) {
      console.error('❌ Error retrieving current team id:', error);
      return null;
    }
  }
}

export const territoryServiceBackend = new TerritoryServiceBackend();
