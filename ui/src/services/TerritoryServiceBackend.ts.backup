        description: 'Residential area along the river',
        team_id: '3d4668db-f4ac-40a2-a89c-f81e8db1d5f5',
        assigned_worker_id: null,
        boundary: JSON.stringify({ 
          type: 'Polygon', 
          coordinates: [[
            [-77.0500, 38.9100],  // Riverside area
