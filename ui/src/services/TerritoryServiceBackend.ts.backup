import AsyncStorage from '@react-native-async-storage/async-storage';
import { STORAGE_KEYS } from './authService';

// API base URL - API Gateway runs on port 8080
const API_BASE_URL = __DEV__ ? 'http://localhost:8080' : 'https://api.rallypoint.app';

// Territory interface matching backend
export interface Territory {
  id: string;
  name: string;
  description: string;
  team_id: string;
  assigned_worker_id: string | null | undefined;
  boundary: string; // JSON string from API
  color: string;
  is_active: boolean;
  created_at: string;
  updated_at: string;
}

export interface TerritoryStats {
  total_territories: number;
  assigned_territories: number;
  covered_today: number;
  total_coverage: number;
  active_workers: number;
}

class TerritoryServiceBackend {
  private async getAuthToken(): Promise<string | null> {
    // Use the same auth service as the rest of the app
    const { authService } = await import('./authService');
    let token = await authService.getStoredToken();
    console.log('🔑 Retrieved token from authService:', !!token);
    
    // If no token, user needs to log in
    if (!token) {
      console.log('⚠️ No auth token found. User may need to log in.');
      return null;
    }
    
    try {
      const mid = token.split('.')[1] || '';
      const b64 = mid.replace(/-/g, '+').replace(/_/g, '/');
      const padded = b64 + '==='.slice((b64.length + 3) % 4);
      const payload = JSON.parse(atob(padded));
      const currentTime = Math.floor(Date.now() / 1000);
      if (payload && payload.exp && payload.exp < currentTime) {
        console.log('⚠️ Token expired, attempting refresh...');
        try {
          const authResponse = await authService.refreshToken();
          token = authResponse.access_token;
          console.log('🔑 Retrieved refreshed token:', !!token);
        } catch (refreshError) {
          console.error('⚠️ Token refresh failed, user may need to log in again:', refreshError);
          return null;
        }
      }
    } catch (error) {
      console.warn('⚠️ Error parsing token, proceeding without local expiry check');
    }
    
    return token;
  }

  private async makeRequest<T>(endpoint: string, options: RequestInit = {}): Promise<T> {
    const url = `${API_BASE_URL}${endpoint}`;
    const token = await this.getAuthToken();

    console.log(`🔗 Territory API Request: ${options.method || 'GET'} ${url}`);
    console.log(`🔑 Auth token present: ${!!token}`);
    console.log(`🔑 Auth token preview: ${token ? token.substring(0, 20) + '...' : 'none'}`);

    const response = await fetch(url, {
      headers: {
        'Content-Type': 'application/json',
        ...(token && { Authorization: `Bearer ${token}` }),
        ...options.headers,
      },
      ...options,
    });

    if (!response.ok) {
      const errorText = await response.text();
      console.error(`❌ Territory API Error: ${response.status} - ${errorText}`);
      throw new Error(errorText || `HTTP ${response.status}`);
    }

    return response.json();
  }

  // Get territories for the current user's team
  async getTeamTerritories(): Promise<{ territories: Territory[]; count: number }> {
    try {
      // First get current user to determine team
      const userResponse = await this.makeRequest<any>('/api/users/profile');
      const user = userResponse;

      console.log('👤 User profile loaded:', user);

      // TEMPORARY: Use the created team ID for testing
      let teamId = user?.team_id;
      if (!teamId) {
        console.log('⚠️ User has no team_id, using test team for debugging');
        teamId = '48608511-94c1-46ec-a4a6-c98bacdc224b'; // Use the newly created team ID
      }

      console.log(`🗺️ Loading territories for team: ${teamId}`);
      
      const response = await this.makeRequest<{ territories: Territory[]; count: number }>(
        `/api/territories/team/${teamId}`
      );

      console.log(`✅ Loaded ${response.count} territories for team`);
      return response;
    } catch (error: any) {
      console.error('❌ Error loading team territories:', error);
      
      // Fallback to mock data if backend is unavailable
      console.log('🔄 Using mock territory data as fallback');
      return this.getMockTerritories();
    }
  }

