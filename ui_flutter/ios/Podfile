source 'https://github.com/CocoaPods/Specs.git'

platform :ios, '14.0'

# Dynamically resolve the Flutter SDK path
def flutter_root
  env_flutter_root = ENV['FLUTTER_ROOT']
  return env_flutter_root.strip if env_flutter_root && !env_flutter_root.strip.empty?

  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  if File.exist?(generated_xcode_build_settings_path)
    File.foreach(generated_xcode_build_settings_path) do |line|
      matches = line.match(/\AFLUTTER_ROOT=(.*)\z/)
      return matches[1].strip if matches
    end
  end

  # Fallback to Flutter config JSON if xcconfig fails
  begin
    require 'json'
    flutter_config = JSON.parse(`flutter config --machine`)
    flutter_root_from_config = flutter_config['flutterRoot']
    return flutter_root_from_config.strip if flutter_root_from_config && !flutter_root_from_config.strip.empty?
  rescue
  end

  # Last resort: infer from flutter binary path
  flutter_bin = `which flutter`.strip
  if flutter_bin && !flutter_bin.empty?
    return File.expand_path('..', File.dirname(flutter_bin))
  end

  raise "Unable to determine FLUTTER_ROOT"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '14.0'
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
        'PERMISSION_MICROPHONE=1',
        'PERMISSION_CAMERA=1',
        'PERMISSION_PHOTOS=1',
        'PERMISSION_LOCATION=1',
      ]
    end
  end
end
